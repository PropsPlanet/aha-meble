{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.ahameble.pl" }],
      "destination": "https://ahameble.pl/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ahameble.pl" }],
      "destination": "https://ahameble.pl/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/imgs/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
